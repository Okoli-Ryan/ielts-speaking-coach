{
  "name": "ielts-speaking-coach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IELTS Speaking examiner, marker and coach on OpenAI or Anthropic models",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test evals/lib/text.test.js evals/repair.score.test.js evals/align.test.js evals/providers.test.js",
    "eval": "node evals/run.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "openai": "^7.10.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "engines": {
    "node": ">=20"
  }
}
