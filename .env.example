# Add a key for at least one provider. The model picker shows which are available,
# and greys out the rest.
OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...

PORT=5173

# Optional: the model used on first load. Defaults to the first model whose provider
# has a key. Any id from server/models.js.
# DEFAULT_MODEL=claude-sonnet-5-5

# Optional, untested: point the OpenAI provider at a service that implements OpenAI's
# Responses API. Servers that only offer chat completions will not work.
# OPENAI_BASE_URL=

# Optional: audio re-transcription. OpenAI only; Anthropic has no speech-to-text.
# Default: gpt-transcribe
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
